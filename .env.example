# Copy to .env and adjust for your environment.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# PostgreSQL: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://loveandtails:loveandtails@localhost:5432/loveandtails

# Web app origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:3000

JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=30
