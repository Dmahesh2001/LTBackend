# Copy to .env and adjust for your environment.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# PostgreSQL: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://loveandtails:loveandtails@localhost:5432/loveandtails

# Redis (cache + rate limit counters). Use rediss:// for TLS.
REDIS_URL=redis://localhost:6379/0

# Number of proxies/load balancers in front of the app (usually 1 in production).
# Leave unset locally.
# NUM_PROXIES=1

# Web app origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:3000

JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=30

# Email. Leave EMAIL_HOST empty to print emails to the console (local dev).
# Works with any SMTP provider (Amazon SES, SendGrid, Mailgun, Postmark, Resend, Gmail...).
DEFAULT_FROM_EMAIL="Love and Tails <hello@yourdomain.com>"
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Waitlist confirmation emails. Defaults to on only when EMAIL_HOST is set;
# set True locally to preview the email in the console.
# WAITLIST_CONFIRMATION_EMAILS=False

# Security
# Admin path. Use something non-obvious in production, e.g. manage-7f3k/
DJANGO_ADMIN_URL=admin/
# API docs (Swagger/ReDoc). Defaults to public when DJANGO_DEBUG=True, staff-only otherwise.
# API_DOCS_PUBLIC=False
# Only needed if the web app switches to cookie-based auth.
# CORS_ALLOW_CREDENTIALS=False
# Production only (DJANGO_DEBUG=False): raise HSTS to 31536000 once HTTPS works.
# DJANGO_SECURE_HSTS_SECONDS=60
LOG_LEVEL=INFO
